<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root{ color-scheme: light dark; }
  html,body{ margin:0; padding:0; }
  img{ max-width:100%; }
  [hidden]{ display:none !important; }
</style><title>Grin Machine</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Shantell+Sans:wght@600;700&display=swap">

<style>
  :root{
    --paper:#E7E0CC;
    --paper-2:#F3EDDE;
    --ink:#2B211A;
    --ink-soft:#6E6052;
    --line:#2B211A;
    --rule:2px;

    /* pigments — physical, identical in both themes */
    --face:#FFC21A;
    --soot:#2B211A;
    --tomato:#DE4B26;
    --pool:#24748F;
    --avocado:#5E7A31;
    --plum:#7A3E86;
    --on-tomato:#FFF4E2;

    --shadow:#2B211A;
    --focus:#24748F;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#1B1611;
      --paper-2:#2A2219;
      --ink:#F1E9D7;
      --ink-soft:#A5947E;
      --line:#54452F;
      --shadow:#0C0906;
      --focus:#6FC1DC;
    }
  }
  :root[data-theme="dark"]{
    --paper:#1B1611;
    --paper-2:#2A2219;
    --ink:#F1E9D7;
    --ink-soft:#A5947E;
    --line:#54452F;
    --shadow:#0C0906;
    --focus:#6FC1DC;
  }

  *{ box-sizing:border-box; }

  body{
    background:var(--paper);
    color:var(--ink);
    font-family:"Archivo", "Segoe UI", system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    max-width:720px;
    margin-inline:auto;
    padding:clamp(18px,4vw,40px) clamp(16px,4vw,24px) clamp(40px,7vw,64px);
    display:flex;
    flex-direction:column;
    gap:clamp(18px,3.2vw,28px);
  }

  /* ---- masthead ---- */
  .masthead{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
    border-bottom:var(--rule) solid var(--line);
    padding-bottom:10px;
  }
  h1{
    font-family:"Shantell Sans","Comic Sans MS",cursive;
    font-weight:700;
    font-size:clamp(30px,7vw,46px);
    line-height:.95;
    margin:0;
    letter-spacing:-.01em;
    text-wrap:balance;
  }
  h1 .dot{ color:var(--tomato); }
  .kicker{
    font-size:12px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.14em;
    color:var(--ink-soft);
    margin:0;
  }
  .deck{
    font-size:14.5px;
    line-height:1.5;
    color:var(--ink-soft);
    margin:0;
    flex:0 1 270px;
  }

  /* ---- badge stage ---- */
  .stage-row{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:14px;
  }
  .stage{
    position:relative;
    width:min(390px, 68vw);
    aspect-ratio:1;
  }
  /* off-register ghost ring behind the badge */
  .stage::before{
    content:"";
    position:absolute;
    inset:0;
    border-radius:50%;
    background:var(--tomato);
    transform:translate(7px,8px);
    opacity:.9;
  }
  canvas{
    position:relative;
    display:block;
    width:100%;
    height:100%;
    border-radius:50%;
    touch-action:none;
    cursor:crosshair;
    border:3px solid var(--soot);
  }
  canvas:focus-visible{ outline:3px solid var(--focus); outline-offset:6px; }

  .specimen{
    font-size:11px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.16em;
    color:var(--ink-soft);
    text-align:center;
    min-height:1.2em;
  }

  /* ---- marker tray ---- */
  .tray{
    background:var(--paper-2);
    border:var(--rule) solid var(--line);
    box-shadow:4px 4px 0 var(--shadow);
    padding:14px 16px;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:18px 26px;
  }
  .group{ display:flex; align-items:center; gap:10px; }
  .lab{
    font-size:10px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.18em;
    color:var(--ink-soft);
  }
  .swatches, .nibs{ display:flex; align-items:center; gap:8px; }

  .sw{
    width:28px; height:28px;
    border-radius:50%;
    border:2px solid var(--line);
    background:var(--sw);
    padding:0;
    cursor:pointer;
    transition:transform .12s ease;
  }
  .sw:hover{ transform:translateY(-2px); }
  .sw[aria-pressed="true"]{
    box-shadow:0 0 0 3px var(--paper-2), 0 0 0 5px var(--line);
  }

  .chip{
    font-family:inherit;
    font-size:10px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.14em;
    color:var(--ink);
    background:var(--paper);
    border:2px solid var(--line);
    border-radius:999px;
    padding:7px 12px;
    cursor:pointer;
  }
  .chip[aria-pressed="true"]{ background:var(--ink); color:var(--paper-2); }

  .nib{
    width:32px; height:28px;
    display:grid; place-items:center;
    background:var(--paper);
    border:2px solid var(--line);
    border-radius:6px;
    padding:0;
    cursor:pointer;
  }
  .nib i{ display:block; background:var(--ink); border-radius:50%; }
  .nib[aria-pressed="true"]{ background:var(--ink); }
  .nib[aria-pressed="true"] i{ background:var(--paper-2); }

  /* ---- actions ---- */
  .actions{
    display:flex;
    flex-wrap:wrap;
    align-items:stretch;
    gap:12px;
  }
  .btn{
    font-family:inherit;
    font-weight:700;
    font-size:14px;
    letter-spacing:.02em;
    border:var(--rule) solid var(--line);
    background:var(--paper-2);
    color:var(--ink);
    padding:13px 20px;
    cursor:pointer;
    box-shadow:4px 4px 0 var(--shadow);
    transition:transform .08s ease, box-shadow .08s ease;
  }
  .btn:hover{ transform:translate(-1px,-1px); box-shadow:5px 5px 0 var(--shadow); }
  .btn:active{ transform:translate(4px,4px); box-shadow:0 0 0 var(--shadow); }
  .btn-go{
    flex:1 1 240px;
    background:var(--tomato);
    color:var(--on-tomato);
    border-color:var(--soot);
    font-family:"Shantell Sans","Comic Sans MS",cursive;
    font-size:clamp(19px,3.6vw,23px);
    padding:14px 22px;
  }
  :root[data-theme="dark"] .btn-go, :root:not([data-theme="light"]) .btn-go{ border-color:var(--line); }

  button:focus-visible{ outline:3px solid var(--focus); outline-offset:3px; }

  .footnote{
    font-size:12.5px;
    color:var(--ink-soft);
    line-height:1.5;
    border-top:1px solid var(--line);
    padding-top:12px;
    margin:0;
  }
  kbd{
    font-family:inherit;
    font-size:11px;
    font-weight:700;
    border:1.5px solid var(--line);
    border-radius:4px;
    padding:1px 5px;
    color:var(--ink);
  }

  @media (prefers-reduced-motion: reduce){
    *{ transition:none !important; }
  }
</style>

</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div>
      <p class="kicker">No. 1 &mdash; badge works</p>
      <h1>Grin Machine<span class="dot">.</span></h1>
    </div>
    <p class="deck">Draw on the badge with your finger or mouse &mdash; or hit the button and let the machine draw one.</p>
  </header>

  <div class="stage-row">
    <div class="stage">
      <canvas id="face" width="440" height="440" tabindex="0" aria-label="Smiley badge drawing surface"></canvas>
    </div>
    <p class="specimen" id="specimen">&nbsp;</p>
  </div>

  <div class="tray">
    <div class="group">
      <span class="lab">Ink</span>
      <div class="swatches" id="swatches" role="group" aria-label="Ink colour"></div>
    </div>
    <div class="group">
      <span class="lab">Nib</span>
      <div class="nibs" id="nibs" role="group" aria-label="Nib size"></div>
    </div>
    <div class="group">
      <button class="chip" id="erase" aria-pressed="false">Erase</button>
    </div>
  </div>

  <div class="actions">
    <button class="btn btn-go" id="go">Surprise me</button>
    <button class="btn" id="undo">Undo</button>
    <button class="btn" id="clear">Clear badge</button>
  </div>

  <p class="footnote">
    Every generated face is drawn fresh &mdash; wobbly lines and all, so no two come out the same.
    <kbd>R</kbd> draws a new one, <kbd>Ctrl</kbd>+<kbd>Z</kbd> takes back your last stroke.
  </p>

</div>

<script>
(function(){
  "use strict";

  var canvas = document.getElementById('face');
  var ctx = canvas.getContext('2d');
  var specimenEl = document.getElementById('specimen');

  var TAU = Math.PI * 2;
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- state ---------- */
  var CX = 220, CY = 220, R = 220;
  var faceTint = '#FFC21A';
  var strokes = [];
  var history = [];
  var pen = { color:'#2B211A', w:0.030, erase:false };
  var drawing = null;
  var animId = null;
  var animFull = null;
  var retouched = false;
  var baseLabel = '';

  var INKS = [
    { name:'Soot',    hex:'#2B211A' },
    { name:'Tomato',  hex:'#DE4B26' },
    { name:'Pool',    hex:'#24748F' },
    { name:'Avocado', hex:'#5E7A31' },
    { name:'Plum',    hex:'#7A3E86' },
    { name:'Chalk',   hex:'#FFF6E4' }
  ];
  var NIBS = [
    { name:'Fine',   w:0.016, dot:5  },
    { name:'Medium', w:0.030, dot:9  },
    { name:'Marker', w:0.052, dot:15 }
  ];

  /* ---------- tiny helpers ---------- */
  function rnd(a,b){ return a + Math.random()*(b-a); }
  function pick(a){ return a[(Math.random()*a.length)|0]; }
  function chance(p){ return Math.random() < p; }

  function arcPts(cx,cy,r,a0,a1,jit,n){
    jit = jit===undefined ? 0.008 : jit; n = n || 22;
    var p = [];
    for(var i=0;i<=n;i++){
      var a = a0 + (a1-a0)*i/n;
      p.push([cx + Math.cos(a)*r + rnd(-jit,jit), cy + Math.sin(a)*r + rnd(-jit,jit)]);
    }
    return p;
  }
  function linePts(x0,y0,x1,y1,jit,n){
    jit = jit===undefined ? 0.007 : jit; n = n || 6;
    var p = [];
    for(var i=0;i<=n;i++){
      var t = i/n;
      p.push([x0+(x1-x0)*t + rnd(-jit,jit), y0+(y1-y0)*t + rnd(-jit,jit)]);
    }
    return p;
  }
  function ovalPts(cx,cy,rx,ry,jit,n){
    jit = jit===undefined ? 0.006 : jit; n = n || 24;
    var p = [];
    for(var i=0;i<=n;i++){
      var a = i/n*TAU;
      p.push([cx + Math.cos(a)*rx + rnd(-jit,jit), cy + Math.sin(a)*ry + rnd(-jit,jit)]);
    }
    return p;
  }

  /* ---------- canvas plumbing ---------- */
  function setup(){
    var rect = canvas.getBoundingClientRect();
    if(!rect.width) return;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width  = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    CX = canvas.width/2;
    CY = canvas.height/2;
    R  = Math.min(CX, CY);
    redraw();
  }

  function clipFace(){
    ctx.beginPath();
    ctx.arc(CX, CY, R, 0, TAU);
    ctx.clip();
  }

  function paintStroke(s, upTo){
    var pts = s.pts;
    var n = (upTo === undefined) ? pts.length : Math.min(pts.length, upTo);
    if(n < 1) return;

    ctx.beginPath();
    for(var i=0;i<n;i++){
      var x = CX + pts[i][0]*R, y = CY + pts[i][1]*R;
      if(i === 0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }

    if(s.fill){
      ctx.closePath();
      ctx.fillStyle = s.color;
      ctx.fill();
      return;
    }
    if(n === 1){
      ctx.lineTo(CX + pts[0][0]*R + 0.01, CY + pts[0][1]*R);
    }
    ctx.strokeStyle = s.erase ? faceTint : s.color;
    ctx.lineWidth = Math.max(1, s.w * R);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
  }

  function paintRim(){
    ctx.beginPath();
    ctx.arc(CX, CY, R - R*0.018, 0, TAU);
    ctx.strokeStyle = 'rgba(43,33,26,.14)';
    ctx.lineWidth = Math.max(1, R*0.022);
    ctx.stroke();
  }

  function redraw(list){
    var src = list || strokes;
    ctx.clearRect(0,0,canvas.width,canvas.height);

    ctx.beginPath();
    ctx.arc(CX, CY, R, 0, TAU);
    ctx.fillStyle = faceTint;
    ctx.fill();

    ctx.save();
    clipFace();
    for(var i=0;i<src.length;i++) paintStroke(src[i]);
    ctx.restore();

    paintRim();
  }

  /* incremental segment while the user is dragging */
  function paintSegment(s){
    var pts = s.pts, n = pts.length;
    if(n < 2) return;
    ctx.save();
    clipFace();
    ctx.beginPath();
    ctx.moveTo(CX + pts[n-2][0]*R, CY + pts[n-2][1]*R);
    ctx.lineTo(CX + pts[n-1][0]*R, CY + pts[n-1][1]*R);
    ctx.strokeStyle = s.erase ? faceTint : s.color;
    ctx.lineWidth = Math.max(1, s.w * R);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
    ctx.restore();
    paintRim();
  }

  /* ---------- history ---------- */
  function snapshot(){
    history.push(strokes.slice());
    if(history.length > 60) history.shift();
  }
  function undo(){
    finishAnimation();
    if(!history.length) return;
    strokes = history.pop();
    if(!strokes.length) setSpecimen('blank badge');
    redraw();
  }

  function setSpecimen(text){
    specimenEl.textContent = text || ' ';
  }

  /* ---------- the generator ---------- */
  var EYE_STYLES = ['dot','oval','ring','wide','happy','sleepy','cross','star'];
  var EYE_NAMES  = { dot:'pinprick', oval:'oval', ring:'ringed', wide:'saucer',
                     happy:'crescent', sleepy:'sleepy', cross:'knocked-out', star:'starstruck' };
  var MOUTH_STYLES = ['grin','beam','tiny','smirk','wobble','open','tongue'];
  var MOUTH_NAMES  = { grin:'big grin', beam:'beaming', tiny:'little smile', smirk:'smirk',
                       wobble:'wobbly line', open:'wide open', tongue:'tongue out' };
  var TINTS = ['#FFC21A','#FFC21A','#FFC21A','#FFD65E','#F7A9C0','#9FD9C0','#C7B6EF','#FF9E4A'];
  var GEN_INKS = ['#2B211A','#2B211A','#2B211A','#2B211A','#DE4B26','#24748F','#7A3E86'];

  function buildEye(style, x, y, s, ink, lw, out){
    function st(pts){ out.push({ pts:pts, color:ink, w:lw }); }
    function fl(pts, col){ out.push({ pts:pts, color:col || ink, w:lw, fill:true }); }

    if(style === 'dot'){
      fl(ovalPts(x, y, s*0.78, s*0.78));
    } else if(style === 'oval'){
      fl(ovalPts(x, y, s*0.58, s*1.05));
    } else if(style === 'ring'){
      st(ovalPts(x, y, s, s, 0.006));
      fl(ovalPts(x + s*0.14, y + s*0.12, s*0.40, s*0.40, 0.004));
    } else if(style === 'wide'){
      st(ovalPts(x, y, s*1.18, s*1.18, 0.007, 28));
      fl(ovalPts(x + rnd(-0.02,0.02), y + s*0.18, s*0.44, s*0.44, 0.004));
    } else if(style === 'happy'){
      st(arcPts(x, y + s*0.34, s, Math.PI*1.06, Math.PI*1.94, 0.008, 18));
    } else if(style === 'sleepy'){
      st(arcPts(x, y + s*0.10, s, Math.PI*1.04, Math.PI*1.96, 0.008, 18));
      st(linePts(x - s*0.55, y + s*0.46, x + s*0.55, y + s*0.46, 0.005, 4));
    } else if(style === 'cross'){
      st(linePts(x - s*0.8, y - s*0.8, x + s*0.8, y + s*0.8, 0.007, 5));
      st(linePts(x + s*0.8, y - s*0.8, x - s*0.8, y + s*0.8, 0.007, 5));
    } else if(style === 'star'){
      st(linePts(x - s, y, x + s, y, 0.006, 4));
      st(linePts(x, y - s, x, y + s, 0.006, 4));
      st(linePts(x - s*0.7, y - s*0.7, x + s*0.7, y + s*0.7, 0.006, 4));
      st(linePts(x + s*0.7, y - s*0.7, x - s*0.7, y + s*0.7, 0.006, 4));
    }
  }

  function buildMouth(style, ink, lw, out){
    function st(pts){ out.push({ pts:pts, color:ink, w:lw }); }
    var i, a, t, p;

    if(style === 'grin'){
      st(arcPts(0, 0.04, 0.50, Math.PI*0.16, Math.PI*0.84, 0.010, 26));
    } else if(style === 'beam'){
      var a0 = Math.PI*0.13, a1 = Math.PI*0.87, r = 0.52, cy = 0.02;
      st(arcPts(0, cy, r, a0, a1, 0.010, 26));
      st(linePts(Math.cos(a0)*r, cy + Math.sin(a0)*r, Math.cos(a0)*r + 0.02, cy + Math.sin(a0)*r - 0.12, 0.006, 4));
      st(linePts(Math.cos(a1)*r, cy + Math.sin(a1)*r, Math.cos(a1)*r - 0.02, cy + Math.sin(a1)*r - 0.12, 0.006, 4));
    } else if(style === 'tiny'){
      st(arcPts(rnd(-0.06,0.06), 0.24, 0.17, Math.PI*0.10, Math.PI*0.90, 0.006, 14));
    } else if(style === 'smirk'){
      var d = chance(0.5) ? 1 : -1;
      st(arcPts(0.10*d, 0.12, 0.34, Math.PI*(d>0 ? 0.04 : 0.26), Math.PI*(d>0 ? 0.74 : 0.96), 0.008, 20));
    } else if(style === 'wobble'){
      p = [];
      for(i=0;i<=26;i++){
        t = i/26;
        p.push([-0.42 + 0.84*t, 0.30 + Math.sin(t*Math.PI*3)*0.055 + rnd(-0.008,0.008)]);
      }
      st(p);
    } else if(style === 'open' || style === 'tongue'){
      var rr = 0.32, my = 0.20;
      p = [[-rr, my], [rr, my]];
      for(i=0;i<=22;i++){
        a = i/22*Math.PI;
        p.push([Math.cos(a)*rr + rnd(-0.006,0.006), my + Math.sin(a)*rr*1.15 + rnd(-0.006,0.006)]);
      }
      out.push({ pts:p, color:ink, w:lw, fill:true });
      if(style === 'tongue'){
        out.push({ pts:ovalPts(0, my + rr*0.95, rr*0.44, rr*0.33, 0.004, 20), color:'#E8607A', w:lw, fill:true });
      }
    }
  }

  function buildBrows(ink, lw, ex, ey, s, out){
    var mode = pick(['raised','furrow','flat','cocked']);
    var w = s*1.45, top = ey - s*1.75;

    function brow(x, side, lift, tilt){
      out.push({ pts:linePts(x - w, top + lift + tilt, x + w, top + lift - tilt, 0.007, 6), color:ink, w:lw });
    }
    if(mode === 'raised'){ brow(-ex,-1,-0.035,-0.018); brow(ex,1,-0.035,0.018); }
    else if(mode === 'furrow'){ brow(-ex,-1,0.02,-0.045); brow(ex,1,0.02,0.045); }
    else if(mode === 'flat'){ brow(-ex,-1,0,0); brow(ex,1,0,0); }
    else { brow(-ex,-1,-0.055,-0.02); brow(ex,1,0.01,0.02); }
    return mode === 'cocked' ? 'one brow up' : mode + ' brows';
  }

  function buildFace(){
    var out = [];
    var parts = [];
    var ink = pick(GEN_INKS);
    var tint = pick(TINTS);
    var lw = rnd(0.026, 0.042);

    var eyeStyle = pick(EYE_STYLES);
    var s  = rnd(0.085, 0.115);
    var ex = rnd(0.33, 0.40);
    var ey = rnd(-0.26, -0.16);

    var winking = chance(0.14) && eyeStyle !== 'happy';
    buildEye(eyeStyle, -ex, ey, s, ink, lw, out);
    buildEye(winking ? 'happy' : eyeStyle, ex, ey, s, ink, lw, out);
    parts.push(EYE_NAMES[eyeStyle] + ' eyes');
    if(winking) parts.push('winking');

    if(chance(0.45)) parts.push(buildBrows(ink, lw*0.9, ex, ey, s, out));

    var mouthStyle = pick(MOUTH_STYLES);
    buildMouth(mouthStyle, ink, lw, out);
    parts.push(MOUTH_NAMES[mouthStyle]);

    if(chance(0.30)){
      out.push({ pts:ovalPts(-0.60, 0.14, 0.11, 0.075, 0.004, 20), color:'rgba(222,80,43,.34)', w:lw, fill:true });
      out.push({ pts:ovalPts( 0.60, 0.14, 0.11, 0.075, 0.004, 20), color:'rgba(222,80,43,.34)', w:lw, fill:true });
      parts.push('blushing');
    }
    if(chance(0.22)){
      for(var f=0; f<7; f++){
        var side = f % 2 ? 1 : -1;
        out.push({
          pts: ovalPts(side*rnd(0.42,0.66), rnd(0.02,0.20), 0.018, 0.018, 0.002, 10),
          color:'rgba(43,33,26,.45)', w:lw, fill:true
        });
      }
      parts.push('freckles');
    }
    if(chance(0.12)){
      out.push({ pts:ovalPts(0.52, -0.48, 0.045, 0.062, 0.004, 16), color:'#24748F', w:lw, fill:true });
      parts.push('one nervous bead of sweat');
    }

    return { strokes:out, tint:tint, label:parts.join(' · ') };
  }

  /* ---------- draw-on animation ---------- */
  function cost(s){ return s.fill ? 5 : s.pts.length; }

  function finishAnimation(){
    if(animId === null) return;
    cancelAnimationFrame(animId);
    animId = null;
    if(animFull){ strokes = animFull; animFull = null; redraw(); }
  }

  function animateIn(list){
    finishAnimation();
    animFull = list;
    var total = 0;
    for(var i=0;i<list.length;i++) total += cost(list[i]);
    var dur = 900;
    var t0 = performance.now();

    function frame(now){
      var p = Math.min(1, (now - t0)/dur);
      var target = p * total;
      var vis = [], acc = 0;
      for(var i=0;i<list.length;i++){
        var s = list[i], c = cost(s);
        if(acc + c <= target){ vis.push(s); acc += c; continue; }
        var k = Math.floor(target - acc);
        if(k > 0){
          if(s.fill) vis.push(s);
          else vis.push({ pts:s.pts.slice(0, k+1), color:s.color, w:s.w });
        }
        break;
      }
      strokes = vis;
      redraw();
      if(p < 1){ animId = requestAnimationFrame(frame); }
      else { animId = null; animFull = null; strokes = list; redraw(); }
    }
    animId = requestAnimationFrame(frame);
  }

  function generate(animate){
    finishAnimation();
    snapshot();
    var built = buildFace();
    faceTint = built.tint;
    retouched = false;
    baseLabel = built.label;
    setSpecimen(built.label);
    if(animate && !reduceMotion){
      strokes = [];
      redraw();
      animateIn(built.strokes);
    } else {
      strokes = built.strokes;
      redraw();
    }
  }

  /* ---------- freehand input ---------- */
  function toUnit(e){
    var r = canvas.getBoundingClientRect();
    var x = (e.clientX - r.left) / r.width  * canvas.width;
    var y = (e.clientY - r.top)  / r.height * canvas.height;
    return [(x - CX)/R, (y - CY)/R];
  }

  canvas.addEventListener('pointerdown', function(e){
    var p = toUnit(e);
    if(Math.hypot(p[0], p[1]) > 1.02) return;
    finishAnimation();
    e.preventDefault();
    canvas.setPointerCapture(e.pointerId);
    snapshot();
    drawing = {
      pts:[p, p.slice()],
      color: pen.color,
      w: pen.erase ? 0.085 : pen.w,
      erase: pen.erase
    };
    strokes.push(drawing);
    paintSegment(drawing);

    if(baseLabel && !retouched){ retouched = true; setSpecimen(baseLabel + ' · retouched'); }
    else if(!baseLabel){ setSpecimen('hand-drawn'); }
  });

  canvas.addEventListener('pointermove', function(e){
    if(!drawing) return;
    e.preventDefault();
    var p = toUnit(e);
    var last = drawing.pts[drawing.pts.length - 1];
    if(Math.hypot(p[0]-last[0], p[1]-last[1]) < 0.004) return;
    drawing.pts.push(p);
    paintSegment(drawing);
  });

  function endStroke(){ drawing = null; }
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);
  canvas.addEventListener('pointerleave', endStroke);

  /* ---------- controls ---------- */
  var swatchEls = [];
  var swatchWrap = document.getElementById('swatches');
  INKS.forEach(function(c, i){
    var b = document.createElement('button');
    b.className = 'sw';
    b.style.setProperty('--sw', c.hex);
    b.setAttribute('aria-label', c.name + ' ink');
    b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
    b.addEventListener('click', function(){
      pen.color = c.hex;
      pen.erase = false;
      eraseBtn.setAttribute('aria-pressed','false');
      swatchEls.forEach(function(o){ o.setAttribute('aria-pressed','false'); });
      b.setAttribute('aria-pressed','true');
    });
    swatchEls.push(b);
    swatchWrap.appendChild(b);
  });

  var nibEls = [];
  var nibWrap = document.getElementById('nibs');
  NIBS.forEach(function(n, i){
    var b = document.createElement('button');
    b.className = 'nib';
    b.setAttribute('aria-label', n.name + ' nib');
    b.setAttribute('aria-pressed', i === 1 ? 'true' : 'false');
    var d = document.createElement('i');
    d.style.width = n.dot + 'px';
    d.style.height = n.dot + 'px';
    b.appendChild(d);
    b.addEventListener('click', function(){
      pen.w = n.w;
      nibEls.forEach(function(o){ o.setAttribute('aria-pressed','false'); });
      b.setAttribute('aria-pressed','true');
    });
    nibEls.push(b);
    nibWrap.appendChild(b);
  });

  var eraseBtn = document.getElementById('erase');
  eraseBtn.addEventListener('click', function(){
    pen.erase = !pen.erase;
    eraseBtn.setAttribute('aria-pressed', pen.erase ? 'true' : 'false');
    if(pen.erase) swatchEls.forEach(function(o){ o.setAttribute('aria-pressed','false'); });
    else swatchEls.forEach(function(o, i){ o.setAttribute('aria-pressed', INKS[i].hex === pen.color ? 'true' : 'false'); });
  });

  document.getElementById('go').addEventListener('click', function(){ generate(true); });
  document.getElementById('undo').addEventListener('click', undo);
  document.getElementById('clear').addEventListener('click', function(){
    finishAnimation();
    snapshot();
    strokes = [];
    baseLabel = '';
    retouched = false;
    setSpecimen('blank badge');
    redraw();
  });

  document.addEventListener('keydown', function(e){
    var typing = /^(input|textarea|select)$/i.test((e.target.tagName || ''));
    if(typing) return;
    if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z'){ e.preventDefault(); undo(); }
    else if(e.key.toLowerCase() === 'r' && !e.ctrlKey && !e.metaKey && !e.altKey){ e.preventDefault(); generate(true); }
  });

  /* ---------- boot ---------- */
  if(window.ResizeObserver){
    new ResizeObserver(function(){ setup(); }).observe(canvas);
  } else {
    window.addEventListener('resize', setup);
  }

  generate(false);
  setup();
})();
</script>

</body>
</html>
